<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="250" prefWidth="350" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pls.ParkingSlotController">
    <children>
        <Label layoutX="83.0" layoutY="24.0" style="-fx-font-size: 16px;" text="Parking Slot Management" />
        <TextField fx:id="slotIdField" layoutX="100.0" layoutY="59.0" promptText="Slot ID (e.g. 1)" />
        <TextField fx:id="statusField" layoutX="100.0" layoutY="99.0" promptText="Occupied (true/false)" />
      <Button layoutX="129.0" layoutY="176.0" onAction="#handleStatusUpdate" text="Update Status" />
        <Label fx:id="resultLabel" layoutX="50" layoutY="180" />
    </children>
</AnchorPane>
