<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="230.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pls.AdminController">
    <children>
        <Label layoutX="130.0" layoutY="20.0" style="-fx-font-size: 16px;" text="Admin Login" />
        <TextField fx:id="usernameField" layoutX="100.0" layoutY="62.0" promptText="Username" />
        <PasswordField fx:id="passwordField" layoutX="100.0" layoutY="102.0" promptText="Password" />
        <Button layoutX="152.0" layoutY="144.0" onAction="#handleAdminLogin" text="Login" />
        <Label fx:id="loginStatusLabel" layoutX="100.0" layoutY="190.0" text="" textFill="red" />
    </children>
</AnchorPane>
