<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="220.0" prefWidth="350.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pls.ParkingRecordController">
    <VBox alignment="CENTER" layoutX="55.0" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label style="-fx-font-size: 18px; -fx-text-fill: #333;" text="Parking Record Entry" />
        <ComboBox fx:id="emptySlotComboBox" prefWidth="200" promptText="Select Empty Slot" style="-fx-background-radius: 6; -fx-padding: 6;" />
        <Button onAction="#handleEntry" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Record Entry" />
        <Label fx:id="resultLabel" style="-fx-text-fill: #333;" />
    </VBox>
</AnchorPane>
