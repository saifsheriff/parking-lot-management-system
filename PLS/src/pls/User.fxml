<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="250" prefWidth="300" style="-fx-background-color: #fafafa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pls.UserController">
    <children>
        <Label layoutX="100.0" layoutY="14.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="User Login" />
        
        <TextField fx:id="nameField" layoutX="50.0" layoutY="55.0" prefWidth="200" promptText="Name" 
                   style="-fx-background-radius: 6; -fx-padding: 6; -fx-border-color: #ccc; -fx-border-radius: 6;" />
        
        <TextField fx:id="emailField" layoutX="50.0" layoutY="105.0" prefWidth="200" promptText="Email" 
                   style="-fx-background-radius: 6; -fx-padding: 6; -fx-border-color: #ccc; -fx-border-radius: 6;" />
        
        <Button layoutX="50.0" layoutY="160.0" prefWidth="90" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" onAction="#handleLogin" text="Login" />
        
        <Button layoutX="160.0" layoutY="160.0" prefWidth="90" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" onAction="#goToRegister" text="Register" />
        
        <Label fx:id="statusLabel" layoutX="50.0" layoutY="210.0" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px;" />
    </children>
</AnchorPane>
